# Public HTTPS URL of this MCP endpoint. Keep the /mcp path.
XBLOOM_MCP_BASE_URL=https://mcp.example.com/mcp

POSTGRES_DB=xbloom
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-random-alphanumeric-password

# Use the same secret for PostgREST JWT verification and the generated service token.
POSTGREST_JWT_SECRET=generated-by-scripts/generate-env.sh
SUPABASE_SERVICE_ROLE_KEY=generated-by-scripts/generate-env.sh

# Independent AES key for encrypted XBloom credentials; 32+ random bytes.
SESSION_ENCRYPTION_KEY=generated-by-scripts/generate-env.sh
